{
  "name": "open-ai-ugc",
  "version": "0.1.0",
  "private": true,
  "description": "Doolphin — an open-source alternative to Arcads and MakeUGC for generating AI UGC video ads with realistic actors, scripts, and voiceovers.",
  "keywords": [
    "ai-ugc",
    "ugc-ads",
    "ai-actors",
    "ai-video-ads",
    "arcads-alternative",
    "makeugc-alternative",
    "user-generated-content",
    "ai-video-generation",
    "text-to-video",
    "image-to-video",
    "veo-3",
    "seedance",
    "grok-video",
    "muapi",
    "nextjs",
    "stripe",
    "saas-template"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack && node -r dotenv/config scripts/check-next-route-cjs.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc -p jsconfig.json --noEmit",
    "test": "node --test tests/*.test.js tests/models/*.test.js",
    "check:legal": "node scripts/check-legal-placeholders.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@libsql/client": "^0.17.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@polar-sh/sdk": "^0.49.0",
    "@prisma/adapter-libsql": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "axios": "^1.16.1",
    "bullmq": "^5.41.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.6.0",
    "next": "16.2.3",
    "next-auth": "^4.24.13",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.6.0",
    "sharp": "^0.34.5",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5.7.0"
  }
}
