# Environment & Hosting
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].supabase.co:5432/postgres"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"
CRON_SECRET="a_long_random_secret_for_vercel_cron"

# Supabase Auth (publishable values may be exposed to the browser; service role never may)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="server_only_never_prefix_with_NEXT_PUBLIC"

# AI Video & Audio Provider API Keys
FAL_KEY="your_fal_key_here"
ELEVENLABS_API_KEY="your_elevenlabs_key_here"
MUAPI_API_KEY="your_muapi_key_here"
MUAPI_API_KEY_SANDBOX="your_muapi_sandbox_key_here"
UGC_API_KEY="your_api_key_here"
WEBHOOK_URL="http://localhost:3000"
MUAPI_WEBHOOK_SECRET="a_separate_long_random_webhook_secret"

# Async Job Queue (Upstash Redis)
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379"

# Polar Payments
POLAR_ACCESS_TOKEN="polar_at_your_access_token_here"
POLAR_WEBHOOK_SECRET="polar_whsec_your_secret_here"
NEXT_PUBLIC_POLAR_ORGANIZATION_ID="your_polar_org_id_here"
POLAR_ENV="sandbox"
POLAR_PRODUCT_EXPLORER=""
POLAR_PRODUCT_STARTER_MONTHLY=""
POLAR_PRODUCT_STARTER_ANNUAL=""
POLAR_PRODUCT_GROWTH_MONTHLY=""
POLAR_PRODUCT_GROWTH_ANNUAL=""
POLAR_PRODUCT_AGENCY_MONTHLY=""
POLAR_PRODUCT_AGENCY_ANNUAL=""

# Cloudflare R2 Storage (required in production; local disk fallback is development-only)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# UI Theme
NEXT_PUBLIC_THEME="light"
